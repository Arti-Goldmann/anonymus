{
  "name": "anonymus",
  "version": "0.1.0",
  "description": "Automatic two-way sync between a project and an AI-agent sandbox with anonymization / deanonymization.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "anonymus": "dist/cli.js"
  },
  "files": [
    "dist",
    "anonymus.example.yaml",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/cli.tsx",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepare": "npm run build",
    "demo": "node scripts/make-demo.mjs",
    "demo:play": "node scripts/play-demo.mjs"
  },
  "dependencies": {
    "chalk": "^5.3.0",
    "chokidar": "^4.0.3",
    "iconv-lite": "^0.6.3",
    "ignore": "^5.3.2",
    "ink": "^5.2.1",
    "ink-spinner": "^5.0.0",
    "ink-text-input": "^6.0.0",
    "js-yaml": "^4.1.0",
    "node-diff3": "^3.1.2",
    "react": "^18.3.1"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.17.0",
    "@types/react": "^18.3.12",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  }
}
